{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/admin/migrate.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "migrations/**"
    },
    "api/cron/ingest-adv.ts": {
      "maxDuration": 800,
      "memory": 3008
    },
    "api/cron/refresh-13f.ts": {
      "maxDuration": 800,
      "memory": 3008
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest-adv",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/refresh-13f",
      "schedule": "0 8 1 */3 *"
    }
  ]
}
