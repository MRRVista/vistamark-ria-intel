{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/admin/migrate.ts": {
      "includeFiles": "migrations/**"
    },
    "api/cron/ingest-adv.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest-adv",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/refresh-13f",
      "schedule": "0 8 1 */3 *"
    }
  ]
}
